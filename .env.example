# Copy to .env and fill in.

# LiteLLM proxy (OpenAI-compatible) — chat + embeddings for the pipeline + judges
LITELLM_BASE_URL=https://your-litellm-proxy.example.com/v1
LITELLM_API_KEY=sk-your-litellm-virtual-key

# Model names as exposed by your LiteLLM proxy.
PIPELINE_MODEL=gpt-4o-mini
JUDGE_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small

# Arize AX — find these in app.arize.com → Settings → API & Space Keys.
ARIZE_SPACE_ID=
ARIZE_API_KEY=
ARIZE_PROJECT_NAME=weekend-planner
